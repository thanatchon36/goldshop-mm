  {
   "id": 12,
   "type": "timeseries",
   "title": "Average markout by horizon (bps, 30m window)",
   "description": "Positive = price moved in our favour after the fill. Persistently negative = adverse selection.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (horizon) (rate(goldshop_markout_bps_sum[30m])) / sum by (horizon) (rate(goldshop_markout_bps_count[30m]))",
     "legendFormat": "+{{horizon}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
